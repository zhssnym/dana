# No trailing slash: a worktree may symlink node_modules to the main
# checkout's copy, and a trailing slash would match directories only.
node_modules
.next/
.data/
dist/
# Playwright's own output: the default outputDir for traces and screenshots,
# and the html report the CI leg writes.
test-results/
playwright-report/
# Generated by src/server/views/explain.ts; regenerate instead of committing.
src/server/views/EXPLAIN.md
desktop.ini
Thumbs.db
.DS_Store
*.tsbuildinfo

# Claude Code: the shared settings are committed, personal ones are not.
.claude/settings.local.json
.claude/worktrees/
CLAUDE.local.md

# Environment files are ignored by shape, so that no .env file can be committed by
# accident. Only the template is tracked.
.env*
!.env.example
