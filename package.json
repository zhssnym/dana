{
  "name": "dana",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch src/server/index.ts",
    "dev:web": "vite",
    "build": "vite build && tsc -p tsconfig.build.json",
    "start": "node dist/src/server/index.js",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && tsc -p tsconfig.node.json",
    "test": "node scripts/run-suite.mjs",
    "gate": "concurrently -n lint,typecheck,build \"npm:lint\" \"npm:typecheck\" \"npm:build\"",
    "e2e": "playwright test",
    "e2e:app": "vite build && tsx db/seed.ts && tsx src/server/index.ts",
    "e2e:app:prebuilt": "tsx db/seed.ts && tsx src/server/index.ts",
    "e2e:install": "playwright install chromium",
    "db:seed": "tsx db/seed.ts",
    "db:verify": "tsx db/verify.ts"
  },
  "dependencies": {
    "@animateicons/react": "^0.4.3",
    "@axiomhq/pino": "^1.8.0",
    "@base-ui/react": "1.7.0",
    "@blocknote/core": "0.54.0",
    "@blocknote/react": "0.54.0",
    "@blocknote/shadcn": "0.54.0",
    "@electric-sql/pglite": "^0.5.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@sentry/node": "^10.70.0",
    "@sentry/react": "^10.70.0",
    "@tanstack/react-query": "^5.101.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.6.2",
    "lucide-react": "^1.31.0",
    "luxon": "^3.7.2",
    "multer": "^2.2.0",
    "openid-client": "^6.8.4",
    "pg": "^8.22.0",
    "pino": "^10.3.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "sharp": "^0.34.5",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/express": "^5.0.6",
    "@types/luxon": "^3.7.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.20.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "eslint": "^9.39.5",
    "jiti": "^2.7.0",
    "jsdom": "^30.0.1",
    "rrule": "2.8.1",
    "shadcn": "4.16.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "js-yaml": "4.3.1",
    "nanoid": "3.3.18"
  }
}
