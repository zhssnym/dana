{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["es2023"],
    "types": ["node"],
    // Anything under tests/ that imports scripts/gate-port.mjs or
    // scripts/gate.mjs, which are plain JavaScript because node runs them with
    // no build step, would otherwise see implicit any and TS7016 would fail
    // the typecheck; tsconfig.node.json carries the same line for
    // playwright.config.ts's import of gate-port.mjs.
    //
    // allowJs, not checkJs: those files are read for the types TypeScript can
    // infer from them rather than typechecked, which is what lets the port
    // resolver be shared without a hand-written .d.mts to drift from it. No
    // file this project includes is JavaScript, so nothing else changes.
    "allowJs": true
  },
  "include": ["src/server/**/*", "src/shared/**/*", "db/**/*", "tests/**/*"],
  // The acceptance suite's component leg is .tsx under tests/ and belongs to
  // tsconfig.client.json, which has the jsx setting, the dom lib, and the
  // bundler resolution it needs and this project deliberately has none of.
  // Without this line those files would be typechecked here too, under node
  // types and no jsx, and would fail on their first element.
  //
  // tests/e2e/**/*.spec.ts, the Playwright leg, is not excluded: those files
  // run in node exactly as the rest of tests/ does, so this project is their
  // home and they need nothing this one lacks.
  "exclude": ["tests/**/*.tsx"]
}
