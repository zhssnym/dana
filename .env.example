# Copy to .env for local development. Production values live in Render.
# Never put a real secret in this file.

PORT=3000
# Only "production" sends email. Every other value logs the email instead.
NODE_ENV=development
# Must not have a trailing slash. The OAuth redirect URI is APP_ORIGIN + /api/v1/auth/google/callback.
APP_ORIGIN=http://localhost:3000

# Database. Empty means embedded PGlite in .data/.
DATABASE_URL=
TEST_DATABASE_URL=

# Google sign-in. Boot needs these three values, or DANA_DEV_LOGIN=1.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_ISSUER_URL=https://accounts.google.com
# 1 enables POST /api/v1/auth/dev-login. Never set it in production.
DANA_DEV_LOGIN=
# 1 allows a local OIDC issuer over plain http. Never set it in production.
OIDC_ALLOW_INSECURE=

# Uploaded files. Set all R2 values, or set DANA_FILES_DIR. With neither, development
# uses a temp directory and a production boot stops. R2_ENDPOINT is optional.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
DANA_FILES_DIR=

# Email (Resend). Production only.
RESEND_API_KEY=
RESEND_FROM=

# Monitoring. Production only. The tokens and the heartbeat URL are credentials.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_RELEASE=
VITE_SENTRY_RELEASE=
AXIOM_DATASET=
AXIOM_TOKEN=
SCHEDULER_HEARTBEAT_URL=

# Comma-separated emails that can read GET /stats.
DANA_OPERATORS=
