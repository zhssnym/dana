{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "lib": ["es2023", "dom", "dom.iterable"],
    "types": ["vite/client"]
  },
  // tests/**/*.tsx is the acceptance suite's component leg. Those files run
  // under jsdom, selected per file by a "@vitest-environment jsdom" docblock so vitest.config.ts's global node
  // environment and the files running under it do not move, and they render
  // client components, so this is the project whose jsx, dom lib, and bundler
  // resolution they need; tsconfig.server.json excludes them for the same
  // reason and keeps every .ts under tests/.
  //
  // The extension is therefore the rule, and it is the whole rule: a file
  // under tests/ that wants the DOM is .tsx and a file that wants node is
  // .ts, including any harness either leg reaches for. Nothing here forces
  // that split beyond the two include lines, so a DOM harness written as .ts
  // typechecks under node types and fails somewhere that does not say why.
  "include": ["src/client/**/*", "src/shared/**/*", "tests/**/*.tsx"],
  // src/shared is compiled by both sides, so the client project would
  // otherwise typecheck the shared modules' own tests under dom lib and
  // bundler resolution, where they neither belong nor run. The server
  // project keeps them.
  //
  // Scoped to src/shared on purpose. An app-rooted "**/*.test.ts" would also
  // drop src/client's own tests, and no other project includes them:
  // tsconfig.server.json covers src/server, src/shared, db, and tests, never
  // src/client. They would run under Vitest while typechecking silently
  // ignored them, which is the failure mode a green gate is worst at
  // reporting. Two entries because tsconfig globs have no brace expansion.
  "exclude": ["src/shared/**/*.test.ts", "src/shared/**/*.test.tsx"]
}
