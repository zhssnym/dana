# Port the single Node process listens on. Defaults to 3000.
PORT=3000

# Postgres connection for the running server. The database half of P0 owns the
# seam that consumes it (app/db/client.ts, spec 11.10).
DATABASE_URL=

# Point the test suite at a real Postgres instead of the embedded PGlite
# default (spec 11.10). CI sets it for the postgres:18 run.
TEST_DATABASE_URL=

# Google OIDC client for the authentication module (spec 11.6). Created in
# the Google Cloud console; the redirect URI to register there is APP_ORIGIN
# plus /api/v1/auth/google/callback (spec 7.1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The OIDC issuer the auth module discovers against. Production means Google,
# https://accounts.google.com; the acceptance suite injects a stub issuer
# through the createApp seam instead (spec 11.10).
GOOGLE_ISSUER_URL=

# This deployment's own origin, scheme included, no trailing slash, for
# example http://localhost:3000. Builds the OAuth redirect_uri, and auth
# endpoints never redirect off it (spec 11.6).
APP_ORIGIN=

# Set to 1 to let the auth module speak plain http to a local issuer, which
# openid-client otherwise refuses. Never set it in production (spec 11.10).
OIDC_ALLOW_INSECURE=

# Set to 1 to enable POST /api/v1/auth/dev-login for sessions without Google
# credentials. Development only; absent from production builds (spec 11.6).
# Boot refuses to start unless either this is 1 or GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, and APP_ORIGIN are all set: a process with neither
# can sign nobody in, and a deploy should fail on that rather than serve it.
DANA_DEV_LOGIN=
