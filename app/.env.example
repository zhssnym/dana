# Port the single Node process listens on. Defaults to 3000.
PORT=3000

# production in production, and nowhere else. It is what decides whether the
# 11.8 notification module sends or logs: the gate is positive, so a process
# that does not say it is production logs every outbound email and sends none.
# The deploy sets it; verify it at the release smoke check rather than assuming
# the host's default, because the failure is quiet on the side that matters
# less (a suppressed send logs a line) and there is no failure at all on the
# side that matters more.
NODE_ENV=

# Postgres connection for the running server. The database half of P0 owns the
# seam that consumes it (app/db/client.ts, spec 11.10).
DATABASE_URL=

# Point the test suite at a real Postgres instead of the embedded PGlite
# default (spec 11.10). CI sets it for the postgres:18 run.
TEST_DATABASE_URL=

# Google OIDC client for the authentication module (spec 11.6). Created in
# the Google Cloud console; the redirect URI to register there is APP_ORIGIN
# plus /api/v1/auth/google/callback (spec 7.1).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The OIDC issuer the auth module discovers against. Production means Google,
# https://accounts.google.com; the acceptance suite injects a stub issuer
# through the createApp seam instead (spec 11.10).
GOOGLE_ISSUER_URL=

# This deployment's own origin, scheme included, no trailing slash, for
# example http://localhost:3000. Builds the OAuth redirect_uri, and auth
# endpoints never redirect off it (spec 11.6). Also the one action link every
# email template carries (spec 10.7).
APP_ORIGIN=

# Set to 1 to let the auth module speak plain http to a local issuer, which
# openid-client otherwise refuses. Never set it in production (spec 11.10).
OIDC_ALLOW_INSECURE=

# Set to 1 to enable POST /api/v1/auth/dev-login for sessions without Google
# credentials. Development only; absent from production builds (spec 11.6).
# Boot refuses to start unless either this is 1 or GOOGLE_CLIENT_ID,
# GOOGLE_CLIENT_SECRET, and APP_ORIGIN are all set: a process with neither
# can sign nobody in, and a deploy should fail on that rather than serve it.
DANA_DEV_LOGIN=

# The email provider of spec 11.8, for the three templates (invite, share
# grant, reminder). Sending happens only when NODE_ENV is production and both
# variables below are set; every other environment logs the suppression and
# sends nothing, which is 11.8's rule and is enforced positively so a stray
# key in a local .env cannot mail a real person. The sender is 10.7's noreply
# address at the product domain, whose SPF, DKIM and DMARC records are the
# launch checklist P10 owns; a domain without them delivers to spam.
RESEND_API_KEY=
RESEND_FROM=

# The spec 11.12 heartbeat the reminder pass pings after each successful
# cycle. Better Stack issues the URL and alerts on silence beyond 10 minutes,
# which is how a dead interval inside a live server becomes visible: an uptime
# check on /api/health cannot see it. Unset means no ping, which is every
# environment but production. Treat the URL as a credential; it is never
# logged.
SCHEDULER_HEARTBEAT_URL=

# Server and browser error tracking (spec 11.12). The browser DSN is public by
# design; both trackers strip error messages, user data, request bodies, and
# breadcrumbs before sending. SENTRY_RELEASE can be the Render git commit.
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_RELEASE=
VITE_SENTRY_RELEASE=
