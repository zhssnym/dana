# Local development only. Gitignored, never committed.
# Production values live in Render's environment panel, not here.
# See .env.example for what each variable is and which spec section owns it.

PORT=3000
NODE_ENV=development

# Left blank on purpose: the server falls back to embedded PGlite in .data/
# when this is unset, which is all local development needs. Point it at a real
# Postgres only if you want to inspect the data with psql.
DATABASE_URL=

# Already set machine-wide for the CI postgres leg. Deliberately not repeated
# here: nothing loads this file for a test run, only server boot.
TEST_DATABASE_URL=

# Paste from the Google Cloud console, OAuth client "Dana web".
# The secret is a credential: it belongs here and nowhere else.
GOOGLE_CLIENT_ID=319499499221-cniid2t1r58spd4k0f7kfuccdt3bc6br.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=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

# Unset means Google (https://accounts.google.com), which is what we want.
GOOGLE_ISSUER_URL=https://accounts.google.com

# This process's own origin. Must match a redirect URI registered on the
# OAuth client, since the callback URL is built from this and never from the
# request Host (11.6, AC-109).
APP_ORIGIN=http://localhost:3000

# Only for a local stub issuer over plain http. Google is https, so leave it
# unset. Never set in production.
OIDC_ALLOW_INSECURE=

# Keeps POST /api/v1/auth/dev-login available alongside real Google sign-in,
# so a session without the console open can still sign in.
DANA_DEV_LOGIN=1

# Nothing sends while NODE_ENV is not production, so these can stay empty
# until the first deploy. The gate is positive by design (11.8).
RESEND_API_KEY=
RESEND_FROM=

# Better Stack heartbeat, production only.
SCHEDULER_HEARTBEAT_URL=
